# Deno
# https://deno.com/

# Cache directory (when using project-local DENO_DIR)
# https://docs.deno.com/runtime/fundamentals/setup/#deno_dir
.deno/

# Coverage reports
# https://docs.deno.com/runtime/reference/cli/coverage/
coverage/
*.lcov

# Browser captures used to reverse-engineer the endpoints.
# These hold live session cookies and personal account data, and run to tens of
# megabytes. Keep them local; the tests use trimmed fixtures instead.
.har/

# npm packages materialised for the optional ./baxia entry point.
node_modules/
